{
  "$defs": {
    "PageInfo": {
      "additionalProperties": false,
      "properties": {
        "has_more": {
          "title": "Has More",
          "type": "boolean"
        },
        "limit": {
          "maximum": 100,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "offset": {
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "total": {
          "minimum": 0,
          "title": "Total",
          "type": "integer"
        }
      },
      "required": [
        "offset",
        "limit",
        "total",
        "has_more"
      ],
      "title": "PageInfo",
      "type": "object"
    },
    "RunEventView": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "estimated_cost_usd": {
          "anyOf": [
            {
              "ge": 0,
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Estimated Cost Usd"
        },
        "event_type": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Event Type",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 100,
          "title": "Evidence Ids",
          "type": "array"
        },
        "mode": {
          "$ref": "#/$defs/RuntimeMode"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "phase": {
          "anyOf": [
            {
              "enum": [
                "DISCOVERING",
                "VERIFYING",
                "EVALUATING",
                "DECISION_UPDATED"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Phase"
        },
        "reason_code": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason Code"
        },
        "reported_cost_usd": {
          "anyOf": [
            {
              "ge": 0,
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reported Cost Usd"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "sequence": {
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "source_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 100,
          "title": "Source Ids",
          "type": "array"
        }
      },
      "required": [
        "run_id",
        "sequence",
        "event_type",
        "mode",
        "occurred_at",
        "reason_code",
        "phase",
        "count",
        "source_ids",
        "evidence_ids",
        "estimated_cost_usd",
        "reported_cost_usd"
      ],
      "title": "RunEventView",
      "type": "object"
    },
    "RunState": {
      "enum": [
        "CREATED",
        "RUNNING",
        "COMPLETED",
        "PARTIAL",
        "FAILED",
        "CANCELLED",
        "BUDGET_STOPPED"
      ],
      "title": "RunState",
      "type": "string"
    },
    "RunView": {
      "additionalProperties": false,
      "properties": {
        "completed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Completed At"
        },
        "fetched_documents": {
          "minimum": 0,
          "title": "Fetched Documents",
          "type": "integer"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/RuntimeMode"
        },
        "official_source_count": {
          "minimum": 0,
          "title": "Official Source Count",
          "type": "integer"
        },
        "opportunity_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Opportunity Id"
        },
        "opportunity_version": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Opportunity Version"
        },
        "provider_state": {
          "anyOf": [
            {
              "const": "DISCONNECTED_LIVE_PROVIDER",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Provider State"
        },
        "reported_cost_usd": {
          "ge": 0,
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Reported Cost Usd",
          "type": "string"
        },
        "reserved_cost_usd": {
          "ge": 0,
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Reserved Cost Usd",
          "type": "string"
        },
        "search_calls": {
          "minimum": 0,
          "title": "Search Calls",
          "type": "integer"
        },
        "started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Started At"
        },
        "state": {
          "$ref": "#/$defs/RunState"
        },
        "termination_reason": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Termination Reason"
        },
        "verified_claim_count": {
          "minimum": 0,
          "title": "Verified Claim Count",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "mode",
        "state",
        "provider_state",
        "opportunity_id",
        "opportunity_version",
        "started_at",
        "completed_at",
        "search_calls",
        "fetched_documents",
        "official_source_count",
        "verified_claim_count",
        "reserved_cost_usd",
        "reported_cost_usd",
        "termination_reason"
      ],
      "title": "RunView",
      "type": "object"
    },
    "RuntimeMode": {
      "enum": [
        "LIVE",
        "FIXTURE",
        "REPLAY"
      ],
      "title": "RuntimeMode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "events": {
      "items": {
        "$ref": "#/$defs/RunEventView"
      },
      "maxItems": 100,
      "title": "Events",
      "type": "array"
    },
    "events_page": {
      "$ref": "#/$defs/PageInfo"
    },
    "runs": {
      "items": {
        "$ref": "#/$defs/RunView"
      },
      "maxItems": 100,
      "title": "Runs",
      "type": "array"
    },
    "runs_page": {
      "$ref": "#/$defs/PageInfo"
    }
  },
  "required": [
    "runs",
    "events",
    "runs_page",
    "events_page"
  ],
  "title": "ActivityResponse",
  "type": "object"
}
