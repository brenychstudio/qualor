{
  "$defs": {
    "Category": {
      "enum": [
        "DEADLINE",
        "ENTRANT_TYPE",
        "GEOGRAPHY",
        "LEGAL_ENTITY",
        "PROJECT_POLICY",
        "LICENSE",
        "REQUIRED_TECHNOLOGY",
        "FINANCIAL_SUPPORT",
        "REWARD_CONDITIONS"
      ],
      "title": "Category",
      "type": "string"
    },
    "ClauseContext": {
      "additionalProperties": false,
      "description": "Bounded exact excerpts and identities of applicable governing clauses.",
      "properties": {
        "context_complete": {
          "title": "Context Complete",
          "type": "boolean"
        },
        "context_section_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 12,
          "title": "Context Section Ids",
          "type": "array"
        },
        "exceptions": {
          "items": {
            "maxLength": 700,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 12,
          "title": "Exceptions",
          "type": "array"
        },
        "qualifiers": {
          "items": {
            "maxLength": 700,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 12,
          "title": "Qualifiers",
          "type": "array"
        },
        "section_id": {
          "minLength": 1,
          "title": "Section Id",
          "type": "string"
        },
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "span_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 12,
          "title": "Span Ids",
          "type": "array"
        }
      },
      "required": [
        "source_id",
        "section_id",
        "span_ids",
        "qualifiers",
        "exceptions",
        "context_section_ids",
        "context_complete"
      ],
      "title": "ClauseContext",
      "type": "object"
    },
    "ExtractionState": {
      "enum": [
        "REVIEWED",
        "UNVERIFIED",
        "FAILED"
      ],
      "title": "ExtractionState",
      "type": "string"
    },
    "Provenance": {
      "enum": [
        "USER_ASSERTED",
        "DOCUMENTED",
        "UNKNOWN"
      ],
      "title": "Provenance",
      "type": "string"
    },
    "SourceType": {
      "enum": [
        "OFFICIAL_RULES",
        "OFFICIAL_FAQ",
        "OFFICIAL_APPLICATION",
        "OFFICIAL_ANNOUNCEMENT",
        "OTHER_OFFICIAL",
        "THIRD_PARTY",
        "SYNTHETIC_FIXTURE",
        "SEARCH_SNIPPET"
      ],
      "title": "SourceType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "clause_context": {
      "anyOf": [
        {
          "$ref": "#/$defs/ClauseContext"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "content_hash": {
      "pattern": "^[a-fA-F0-9]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "extraction_state": {
      "$ref": "#/$defs/ExtractionState"
    },
    "final_url": {
      "minLength": 1,
      "title": "Final Url",
      "type": "string"
    },
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "last_refresh_failed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Refresh Failed At"
    },
    "normalized_field": {
      "$ref": "#/$defs/Category"
    },
    "original_url": {
      "minLength": 1,
      "title": "Original Url",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "retrieved_at": {
      "format": "date-time",
      "title": "Retrieved At",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Id"
    },
    "source_type": {
      "$ref": "#/$defs/SourceType"
    },
    "supporting_excerpt": {
      "maxLength": 700,
      "minLength": 1,
      "title": "Supporting Excerpt",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "id",
    "version",
    "created_at",
    "updated_at",
    "provenance",
    "original_url",
    "final_url",
    "retrieved_at",
    "source_type",
    "content_hash",
    "supporting_excerpt",
    "normalized_field",
    "extraction_state"
  ],
  "title": "EvidenceRecord",
  "type": "object"
}
