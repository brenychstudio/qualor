{
  "$defs": {
    "Money": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "ge": 0,
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Amount",
          "type": "string"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        }
      },
      "required": [
        "currency",
        "amount"
      ],
      "title": "Money",
      "type": "object"
    },
    "Provenance": {
      "enum": [
        "USER_ASSERTED",
        "DOCUMENTED",
        "UNKNOWN"
      ],
      "title": "Provenance",
      "type": "string"
    },
    "RewardKind": {
      "enum": [
        "CASH_PRIZE",
        "CLOUD_CREDIT",
        "GRANT",
        "EQUITY_INVESTMENT",
        "IN_KIND"
      ],
      "title": "RewardKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "amount": {
      "anyOf": [
        {
          "$ref": "#/$defs/Money"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "amount_max": {
      "anyOf": [
        {
          "$ref": "#/$defs/Money"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "amount_min": {
      "anyOf": [
        {
          "$ref": "#/$defs/Money"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "conditions": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Conditions",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "eligibility_note": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Eligibility Note"
    },
    "expiry": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expiry"
    },
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "is_total_pool": {
      "default": false,
      "title": "Is Total Pool",
      "type": "boolean"
    },
    "kind": {
      "$ref": "#/$defs/RewardKind"
    },
    "payment_timing": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Payment Timing"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "schema_version": {
      "const": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "id",
    "version",
    "created_at",
    "updated_at",
    "provenance",
    "kind"
  ],
  "title": "Reward",
  "type": "object"
}
