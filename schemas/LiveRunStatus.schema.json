{
  "$defs": {
    "Recommendation": {
      "enum": [
        "APPLY",
        "PREPARE",
        "WATCH",
        "SKIP"
      ],
      "title": "Recommendation",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "completed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completed At"
    },
    "error_code": {
      "anyOf": [
        {
          "enum": [
            "LIVE_RUN_BUSY",
            "LIVE_RUN_LIMIT_REACHED",
            "LIVE_RUN_COOLDOWN",
            "LIVE_RUN_UNAVAILABLE",
            "LIVE_PERSISTENCE_FAILED",
            "LIVE_PROVIDER_FAILED",
            "INTERNAL_LIVE_RUN_FAILURE",
            "LIVE_RUN_INCOMPLETE",
            "BUDGET_STOPPED"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Code"
    },
    "mode": {
      "const": "LIVE",
      "default": "LIVE",
      "title": "Mode",
      "type": "string"
    },
    "opportunity_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Opportunity Id"
    },
    "recommendation": {
      "anyOf": [
        {
          "$ref": "#/$defs/Recommendation"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "status": {
      "enum": [
        "STARTING",
        "RESEARCHING",
        "EVALUATING",
        "COMPLETED",
        "FAILED",
        "BUDGET_STOPPED"
      ],
      "title": "Status",
      "type": "string"
    },
    "termination_reason": {
      "anyOf": [
        {
          "enum": [
            "SUFFICIENT_CRITICAL_EVIDENCE",
            "HARD_FAIL_CONFIRMED",
            "BUDGET_EXHAUSTED",
            "NO_PROGRESS",
            "TOOL_FAILURE_BOUND_REACHED",
            "MAX_STEPS",
            "PROVIDER_DISCONNECTED",
            "INTERNAL_LIVE_RUN_FAILURE"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Termination Reason"
    }
  },
  "required": [
    "run_id",
    "status",
    "started_at"
  ],
  "title": "LiveRunStatus",
  "type": "object"
}
