{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowAgentCoreForQualorGateway",
      "Effect": "Allow",
      "Principal": {
        "Service": "bedrock-agentcore.amazonaws.com"
      },
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringEquals": {
          "aws:SourceAccount": "<AWS_ACCOUNT_ID>"
        },
        "ArnLike": {
          "aws:SourceArn": "<QUALOR_GATEWAY_ARN_PATTERN>"
        }
      }
    }
  ]
}
